# Per-machine secrets — sourced by .zshrc, never published.
# sync2git.sh does `cp -R ~/.zsh`, which would otherwise sweep this in.
secret.zsh
*.secret
.env

# Plugin payloads installed by vim-plug / antidote at runtime
plugged/
bundle/

# Generated by antidote from zsh_plugins.txt. Machine-specific: the bundle cache
# is ~/Library/Caches/antidote on macOS but ~/.cache/antidote on Linux, so this
# must be regenerated per machine, never committed.
zsh_plugins.zsh
*.zwc

# vim-plug keeps its previous version here after :PlugUpgrade
plug.vim.old

# Editor and OS noise
.netrwhist
*.swp
*.swo
*~
.DS_Store
